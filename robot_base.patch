diff --git a/main/robot_base/head_servo.cc b/main/robot_base/head_servo.cc
new file mode 100644
index 0000000..7c420ae
--- /dev/null
+++ b/main/robot_base/head_servo.cc
@@ -0,0 +1,61 @@
+#include "head_servo.h"
+
+#include <esp_log.h>
+
+#define TAG "RobotHead"
+#define SERVO_TIMER LEDC_TIMER_3
+#define SERVO_CH    LEDC_CHANNEL_6
+#define SERVO_RES   LEDC_TIMER_14_BIT
+#define SERVO_HZ    50
+
+bool HeadServo::Init(const Config& cfg) {
+    cfg_ = cfg;
+    ledc_timer_config_t t = {};
+    t.speed_mode = LEDC_LOW_SPEED_MODE;
+    t.duty_resolution = SERVO_RES;
+    t.timer_num = SERVO_TIMER;
+    t.freq_hz = SERVO_HZ;
+    t.clk_cfg = LEDC_AUTO_CLK;
+    if (ledc_timer_config(&t) != ESP_OK) {
+        ESP_LOGE(TAG, "ledc timer config failed");
+        return false;
+    }
+    ledc_channel_config_t c = {};
+    c.gpio_num = cfg_.pin;
+    c.speed_mode = LEDC_LOW_SPEED_MODE;
+    c.channel = SERVO_CH;
+    c.intr_type = LEDC_INTR_DISABLE;
+    c.timer_sel = SERVO_TIMER;
+    c.duty = 0;
+    c.hpoint = 0;
+    if (ledc_channel_config(&c) != ESP_OK) {
+        ESP_LOGE(TAG, "ledc channel config failed");
+        return false;
+    }
+    ready_ = true;
+    SetPose(0);
+    ESP_LOGI(TAG, "servo ready on GPIO%d, center %d deg, range +-%d deg", (int)cfg_.pin, cfg_.center_deg,
+             cfg_.range_deg);
+    return true;
+}
+
+void HeadServo::SetAngleDeg(float deg) {
+    if (!ready_) return;
+    if (deg < 0) deg = 0;
+    if (deg > 180) deg = 180;
+    angle_ = deg;
+    float us = cfg_.min_us + (cfg_.max_us - cfg_.min_us) * (deg / 180.0f);
+    uint32_t max_duty = (1u << SERVO_RES) - 1;
+    uint32_t duty = (uint32_t)(us * SERVO_HZ * (float)(1u << SERVO_RES) / 1000000.0f);
+    if (duty > max_duty) duty = max_duty;
+    ledc_set_duty(LEDC_LOW_SPEED_MODE, SERVO_CH, duty);
+    ledc_update_duty(LEDC_LOW_SPEED_MODE, SERVO_CH);
+}
+
+void HeadServo::SetPose(int pose) {
+    if (pose > 100) pose = 100;
+    if (pose < -100) pose = -100;
+    pose_ = pose;
+    float sign = cfg_.invert ? -1.0f : 1.0f;
+    SetAngleDeg((float)cfg_.center_deg + sign * (float)cfg_.range_deg * (float)pose / 100.0f);
+}
diff --git a/main/robot_base/head_servo.h b/main/robot_base/head_servo.h
new file mode 100644
index 0000000..2d02d5e
--- /dev/null
+++ b/main/robot_base/head_servo.h
@@ -0,0 +1,28 @@
+// SG90 head servo on one LEDC channel (50 Hz). Pose -100..+100 maps to center +/- range degrees.
+#pragma once
+#include <driver/gpio.h>
+#include <driver/ledc.h>
+
+class HeadServo {
+public:
+    struct Config {
+        gpio_num_t pin;
+        int center_deg = 90;
+        int range_deg = 35;     // pose +-100 => center +- range_deg
+        bool invert = false;    // flip direction if "up" moves the head down
+        int min_us = 500;       // SG90: ~500..2400 us
+        int max_us = 2400;
+    };
+    bool Init(const Config& cfg);
+    void SetPose(int pose);          // -100..100
+    void SetAngleDeg(float deg);     // absolute, clamped to 0..180
+    int pose() const { return pose_; }
+    float angle_deg() const { return angle_; }
+    bool ready() const { return ready_; }
+
+private:
+    Config cfg_{};
+    bool ready_ = false;
+    int pose_ = 0;
+    float angle_ = 90;
+};
diff --git a/main/robot_base/motor_driver.cc b/main/robot_base/motor_driver.cc
new file mode 100644
index 0000000..6c2ee55
--- /dev/null
+++ b/main/robot_base/motor_driver.cc
@@ -0,0 +1,118 @@
+#include "motor_driver.h"
+
+#include <esp_log.h>
+
+#include "robot_logic.h"
+
+#define TAG "RobotMotor"
+
+// LEDC resources used by the robot base (backlight uses timer0/ch0, GpioLed timer1/ch0):
+#define MOTOR_TIMER   LEDC_TIMER_2
+#define MOTOR_RES     LEDC_TIMER_10_BIT
+#define CH_L_IN1      LEDC_CHANNEL_2
+#define CH_L_IN2      LEDC_CHANNEL_3
+#define CH_R_IN1      LEDC_CHANNEL_4
+#define CH_R_IN2      LEDC_CHANNEL_5
+
+bool MotorDriver::Init(const Config& cfg) {
+    cfg_ = cfg;
+    mu_ = xSemaphoreCreateMutex();
+    if (!mu_) return false;
+
+    ledc_timer_config_t t = {};
+    t.speed_mode = LEDC_LOW_SPEED_MODE;
+    t.duty_resolution = MOTOR_RES;
+    t.timer_num = MOTOR_TIMER;
+    t.freq_hz = cfg_.pwm_hz;
+    t.clk_cfg = LEDC_AUTO_CLK;
+    if (ledc_timer_config(&t) != ESP_OK) {
+        ESP_LOGE(TAG, "ledc timer config failed");
+        return false;
+    }
+    max_duty_ = 1u << MOTOR_RES;
+
+    struct Map { ledc_channel_t ch; gpio_num_t pin; };
+    const Map maps[] = {
+        {CH_L_IN1, cfg_.left_in1}, {CH_L_IN2, cfg_.left_in2},
+        {CH_R_IN1, cfg_.right_in1}, {CH_R_IN2, cfg_.right_in2},
+    };
+    for (const auto& m : maps) {
+        ledc_channel_config_t c = {};
+        c.gpio_num = m.pin;
+        c.speed_mode = LEDC_LOW_SPEED_MODE;
+        c.channel = m.ch;
+        c.intr_type = LEDC_INTR_DISABLE;
+        c.timer_sel = MOTOR_TIMER;
+        c.duty = 0;
+        c.hpoint = 0;
+        if (ledc_channel_config(&c) != ESP_OK) {
+            ESP_LOGE(TAG, "ledc channel %d (gpio %d) failed", (int)m.ch, (int)m.pin);
+            return false;
+        }
+    }
+    ready_ = true;
+    Coast();
+    ESP_LOGI(TAG, "DRV8833 ready: L=%d/%d R=%d/%d pwm=%luHz duty %d..%d%%", (int)cfg_.left_in1,
+             (int)cfg_.left_in2, (int)cfg_.right_in1, (int)cfg_.right_in2, (unsigned long)cfg_.pwm_hz,
+             cfg_.min_start_pct, cfg_.max_pct);
+    return true;
+}
+
+void MotorDriver::SetDuty(ledc_channel_t ch, uint32_t duty) {
+    if (duty > max_duty_) duty = max_duty_;
+    ledc_set_duty(LEDC_LOW_SPEED_MODE, ch, duty);
+    ledc_update_duty(LEDC_LOW_SPEED_MODE, ch);
+}
+
+void MotorDriver::SetSide(ledc_channel_t a, ledc_channel_t b, int pct, bool invert) {
+    if (invert) pct = -pct;
+    if (pct == 0) {                      // brake: both inputs high (fast stop)
+        SetDuty(a, max_duty_);
+        SetDuty(b, max_duty_);
+        return;
+    }
+    uint32_t duty = (uint32_t)((pct < 0 ? -pct : pct) * max_duty_ / 100);
+    if (pct > 0) {
+        SetDuty(a, duty);
+        SetDuty(b, 0);
+    } else {
+        SetDuty(a, 0);
+        SetDuty(b, duty);
+    }
+}
+
+void MotorDriver::ApplyLocked(int l, int r) {
+    if (inhibit_.load()) robot::RemoveNetForward(l, r);
+    int dl = robot::ToDutyPercent(l, cfg_.min_start_pct, cfg_.max_pct);
+    int dr = robot::ToDutyPercent(r, cfg_.min_start_pct, cfg_.max_pct);
+    SetSide(CH_L_IN1, CH_L_IN2, dl, cfg_.left_invert);
+    SetSide(CH_R_IN1, CH_R_IN2, dr, cfg_.right_invert);
+}
+
+void MotorDriver::Drive(int left, int right) {
+    if (!ready_) return;
+    xSemaphoreTake(mu_, portMAX_DELAY);
+    cmd_l_ = left;
+    cmd_r_ = right;
+    ApplyLocked(left, right);
+    xSemaphoreGive(mu_);
+}
+
+void MotorDriver::Brake() { Drive(0, 0); }
+
+void MotorDriver::Coast() {
+    if (!ready_) return;
+    xSemaphoreTake(mu_, portMAX_DELAY);
+    cmd_l_ = cmd_r_ = 0;
+    SetDuty(CH_L_IN1, 0); SetDuty(CH_L_IN2, 0);
+    SetDuty(CH_R_IN1, 0); SetDuty(CH_R_IN2, 0);
+    xSemaphoreGive(mu_);
+}
+
+void MotorDriver::SetForwardInhibit(bool inhibit) {
+    inhibit_.store(inhibit);
+    if (!ready_) return;
+    xSemaphoreTake(mu_, portMAX_DELAY);
+    ApplyLocked(cmd_l_, cmd_r_);   // re-apply the last command through the interlock right now
+    xSemaphoreGive(mu_);
+}
diff --git a/main/robot_base/motor_driver.h b/main/robot_base/motor_driver.h
new file mode 100644
index 0000000..656554f
--- /dev/null
+++ b/main/robot_base/motor_driver.h
@@ -0,0 +1,47 @@
+// DRV8833 dual H-bridge, 2 PWM pins per wheel (IN1/IN2), no encoder.
+//   forward : IN1 = PWM, IN2 = 0        reverse : IN1 = 0, IN2 = PWM
+//   brake   : IN1 = IN2 = 1             coast   : IN1 = IN2 = 0
+#pragma once
+#include <driver/gpio.h>
+#include <driver/ledc.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/semphr.h>
+
+#include <atomic>
+
+class MotorDriver {
+public:
+    struct Config {
+        gpio_num_t left_in1, left_in2, right_in1, right_in2;
+        bool left_invert = false;
+        bool right_invert = false;
+        int min_start_pct = 30;   // duty needed to overcome stiction
+        int max_pct = 70;         // duty ceiling (protects motors on a 2S pack)
+        uint32_t pwm_hz = 20000;
+    };
+
+    bool Init(const Config& cfg);
+    // Wheel command -100..100 (percent). Applies the forward interlock.
+    void Drive(int left, int right);
+    void Brake();
+    void Coast();
+    // Hardware-level interlock, set from the laser task: removes the net-forward part
+    // of whatever is being driven right now, immediately.
+    void SetForwardInhibit(bool inhibit);
+    bool forward_inhibited() const { return inhibit_.load(); }
+    int left() const { return cmd_l_; }
+    int right() const { return cmd_r_; }
+    bool ready() const { return ready_; }
+
+private:
+    void ApplyLocked(int l, int r);
+    void SetSide(ledc_channel_t ch_a, ledc_channel_t ch_b, int signed_pct, bool invert);
+    void SetDuty(ledc_channel_t ch, uint32_t duty);
+
+    Config cfg_{};
+    bool ready_ = false;
+    SemaphoreHandle_t mu_ = nullptr;
+    std::atomic<bool> inhibit_{false};
+    int cmd_l_ = 0, cmd_r_ = 0;   // last requested (pre-interlock) command
+    uint32_t max_duty_ = 1024;
+};
diff --git a/main/robot_base/range_guard.cc b/main/robot_base/range_guard.cc
new file mode 100644
index 0000000..c799b66
--- /dev/null
+++ b/main/robot_base/range_guard.cc
@@ -0,0 +1,143 @@
+#include "range_guard.h"
+
+#include <esp_log.h>
+#include <esp_timer.h>
+#include <string.h>
+
+#define TAG "RobotRange"
+#define EV_CALIB_DONE BIT0
+#define CAL_SAMPLES 15
+
+void IRAM_ATTR RangeGuard::IsrHandler(void* arg) {
+    auto* self = static_cast<RangeGuard*>(arg);
+    BaseType_t woken = pdFALSE;
+    xSemaphoreGiveFromISR(self->drdy_, &woken);
+    if (woken) portYIELD_FROM_ISR();
+}
+
+bool RangeGuard::Init(i2c_master_bus_handle_t bus, const Config& cfg) {
+    cfg_ = cfg;
+    if (bus == nullptr) {
+        ESP_LOGE(TAG, "no I2C bus");
+        return false;
+    }
+    if (!tof_.attach(bus, cfg_.i2c_addr, 400000)) {
+        ESP_LOGE(TAG, "cannot add I2C device 0x%02x", cfg_.i2c_addr);
+        return false;
+    }
+    tof_.setTimeout(100);
+    if (!tof_.init(true)) {
+        ESP_LOGE(TAG, "VL53L0X init failed (wiring? address 0x%02x)", cfg_.i2c_addr);
+        return false;
+    }
+    // Fast ranging: 20 ms budget, back-to-back continuous mode, interrupt on every sample.
+    tof_.setMeasurementTimingBudget(20000);
+    tof_.startContinuous(0);
+    tof_.setTimeout(30);
+    present_ = true;
+
+    robot::HazardConfig hc;
+    hc.cliff_mm = cfg_.cliff_mm;
+    hc.obstacle_margin_mm = cfg_.obstacle_margin_mm;
+    cls_.Configure(hc);
+    cls_.SetFloor(0);
+
+    events_ = xEventGroupCreate();
+    drdy_ = xSemaphoreCreateBinary();
+    if (!events_ || !drdy_) return false;
+
+    if (cfg_.int_pin != GPIO_NUM_NC) {
+        gpio_config_t io = {};
+        io.pin_bit_mask = 1ULL << cfg_.int_pin;
+        io.mode = GPIO_MODE_INPUT;
+        io.pull_up_en = GPIO_PULLUP_ENABLE;
+        io.pull_down_en = GPIO_PULLDOWN_DISABLE;
+        io.intr_type = GPIO_INTR_NEGEDGE;
+        gpio_config(&io);
+        esp_err_t e = gpio_install_isr_service(0);   // ESP_ERR_INVALID_STATE = already installed, fine
+        if (e != ESP_OK && e != ESP_ERR_INVALID_STATE) ESP_LOGW(TAG, "isr service: %s", esp_err_to_name(e));
+        gpio_isr_handler_add(cfg_.int_pin, IsrHandler, this);
+    }
+
+    last_ok_us_.store(esp_timer_get_time());
+    calib_req_.store(true);   // calibrate the floor automatically at boot (robot must stand on the floor)
+    BaseType_t ok = xTaskCreate(TaskEntry, "robot_range", 4096, this, 6, &task_);
+    ESP_LOGI(TAG, "VL53L0X ready (INT=GPIO%d), cliff > %u mm", (int)cfg_.int_pin, cfg_.cliff_mm);
+    return ok == pdPASS;
+}
+
+bool RangeGuard::healthy() const {
+    if (!present_) return false;
+    int64_t age_ms = (esp_timer_get_time() - last_ok_us_.load()) / 1000;
+    return age_ms < 300 && hazard_.load() != robot::Hazard::kSensorFault;
+}
+
+bool RangeGuard::Calibrate() {
+    if (!present_) return false;
+    xEventGroupClearBits(events_, EV_CALIB_DONE);
+    calib_ok_.store(false);
+    calib_req_.store(true);
+    EventBits_t b = xEventGroupWaitBits(events_, EV_CALIB_DONE, pdTRUE, pdFALSE, pdMS_TO_TICKS(3000));
+    return (b & EV_CALIB_DONE) && calib_ok_.load();
+}
+
+void RangeGuard::TaskEntry(void* arg) {
+    static_cast<RangeGuard*>(arg)->Loop();
+    vTaskDelete(nullptr);
+}
+
+void RangeGuard::Loop() {
+    uint16_t cal[CAL_SAMPLES];
+    size_t cal_n = 0;
+    bool calibrating = false;
+    robot::Hazard prev = robot::Hazard::kUnknown;
+    uint32_t warned = 0;
+
+    for (;;) {
+        // wait for the data-ready interrupt; fall back to polling if INT is not wired
+        bool got_int = xSemaphoreTake(drdy_, pdMS_TO_TICKS(40)) == pdTRUE;
+        if (!got_int && cfg_.int_pin != GPIO_NUM_NC && (warned++ % 100) == 0) {
+            ESP_LOGW(TAG, "no data-ready interrupt on GPIO%d, polling instead", (int)cfg_.int_pin);
+        }
+
+        uint16_t mm = tof_.readRangeContinuousMillimeters();
+        bool io_ok = !tof_.timeoutOccurred() && tof_.last_status == 0;
+        if (io_ok) last_ok_us_.store(esp_timer_get_time());
+        last_mm_.store(io_ok ? mm : 0);
+
+        if (calib_req_.exchange(false)) {
+            calibrating = true;
+            cal_n = 0;
+        }
+        if (calibrating) {
+            if (io_ok && mm < 8000 && cal_n < CAL_SAMPLES) cal[cal_n++] = mm;
+            if (cal_n >= CAL_SAMPLES) {
+                uint16_t floor = 0;
+                bool ok = robot::ComputeFloor(cal, cal_n, cfg_.cliff_mm, &floor);
+                if (ok) {
+                    floor_mm_.store(floor);
+                    cls_.SetFloor(floor);
+                    ESP_LOGI(TAG, "floor calibrated: %u mm (cliff > %u, obstacle < %u)", floor, cfg_.cliff_mm,
+                             floor > cfg_.obstacle_margin_mm ? floor - cfg_.obstacle_margin_mm : 0);
+                } else {
+                    floor_mm_.store(0);
+                    cls_.SetFloor(0);
+                    ESP_LOGW(TAG, "floor calibration failed (noisy, too close to cliff, or not on the floor): "
+                                  "obstacle detection off, cliff detection still on");
+                }
+                calib_ok_.store(ok);
+                calibrating = false;
+                xEventGroupSetBits(events_, EV_CALIB_DONE);
+            }
+        }
+
+        robot::Hazard h = cls_.Feed(mm, io_ok);
+        hazard_.store(h);
+        if (h != prev) {
+            ESP_LOGI(TAG, "hazard %s -> %s (range %u mm)", robot::HazardName(prev), robot::HazardName(h), mm);
+            prev = h;
+            if (cb_) cb_(h);
+        }
+        if (!got_int) vTaskDelay(pdMS_TO_TICKS(5));   // never hog the CPU when polling
+    }
+}
diff --git a/main/robot_base/range_guard.h b/main/robot_base/range_guard.h
new file mode 100644
index 0000000..477958f
--- /dev/null
+++ b/main/robot_base/range_guard.h
@@ -0,0 +1,62 @@
+// VL53L0X forward/down laser guard. One sensor, mounted at the front looking diagonally
+// at the floor: a shorter reading than the calibrated floor distance = obstacle,
+// a longer reading (or no echo) = drop / table edge.
+#pragma once
+#include <driver/gpio.h>
+#include <driver/i2c_master.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/event_groups.h>
+#include <freertos/semphr.h>
+#include <freertos/task.h>
+
+#include <atomic>
+#include <functional>
+#include <memory>
+
+#include "robot_logic.h"
+#include "vl53l0x.h"
+
+class RangeGuard {
+public:
+    struct Config {
+        gpio_num_t int_pin = GPIO_NUM_NC;   // VL53L0X GPIO1 (active low, "new sample ready")
+        uint16_t cliff_mm = 150;
+        uint16_t obstacle_margin_mm = 30;
+        uint8_t i2c_addr = 0x29;
+    };
+    using HazardCallback = std::function<void(robot::Hazard)>;
+
+    // Shares an existing i2c_master bus (the OLED bus on the OLED build).
+    bool Init(i2c_master_bus_handle_t bus, const Config& cfg);
+    // Re-measure the floor distance. The robot must stand on flat floor. Blocks up to ~3 s.
+    bool Calibrate();
+
+    robot::Hazard hazard() const { return hazard_.load(); }
+    uint16_t distance_mm() const { return last_mm_.load(); }
+    uint16_t floor_mm() const { return floor_mm_.load(); }
+    bool present() const { return present_; }
+    // true when samples are fresh (< 300 ms old) and there is no I2C fault
+    bool healthy() const;
+    // called from the sensor task on every hazard change: keep it short
+    void SetHazardCallback(HazardCallback cb) { cb_ = std::move(cb); }
+
+private:
+    static void TaskEntry(void* arg);
+    void Loop();
+    static void IRAM_ATTR IsrHandler(void* arg);
+
+    Config cfg_{};
+    VL53L0X tof_;
+    bool present_ = false;
+    robot::HazardClassifier cls_;
+    std::atomic<robot::Hazard> hazard_{robot::Hazard::kUnknown};
+    std::atomic<uint16_t> last_mm_{0};
+    std::atomic<uint16_t> floor_mm_{0};
+    std::atomic<int64_t> last_ok_us_{0};
+    std::atomic<bool> calib_req_{false};
+    std::atomic<bool> calib_ok_{false};
+    EventGroupHandle_t events_ = nullptr;
+    SemaphoreHandle_t drdy_ = nullptr;
+    HazardCallback cb_;
+    TaskHandle_t task_ = nullptr;
+};
diff --git a/main/robot_base/robot_base.cc b/main/robot_base/robot_base.cc
new file mode 100644
index 0000000..c8a56e8
--- /dev/null
+++ b/main/robot_base/robot_base.cc
@@ -0,0 +1,327 @@
+#include "robot_base.h"
+
+#include <cJSON.h>
+#include <esp_log.h>
+#include <esp_timer.h>
+
+#include <math.h>
+#include <stdexcept>
+#include <string>
+
+#include "application.h"
+#include "board.h"
+#include "display.h"
+#include "mcp_server.h"
+#include "robot_emotion_hook.h"
+
+#define TAG "RobotBase"
+#define TICK_MS 20
+
+static inline int64_t NowMs() { return esp_timer_get_time() / 1000; }
+
+RobotBase& RobotBase::GetInstance() {
+    static RobotBase instance;
+    return instance;
+}
+
+i2c_master_bus_handle_t RobotBase::CreateI2cBus() {
+    i2c_master_bus_handle_t bus = nullptr;
+    i2c_master_bus_config_t cfg = {
+        .i2c_port = (i2c_port_t)0,
+        .sda_io_num = (gpio_num_t)CONFIG_ROBOT_I2C_SDA,
+        .scl_io_num = (gpio_num_t)CONFIG_ROBOT_I2C_SCL,
+        .clk_source = I2C_CLK_SRC_DEFAULT,
+        .glitch_ignore_cnt = 7,
+        .intr_priority = 0,
+        .trans_queue_depth = 0,
+        .flags = {
+            .enable_internal_pullup = 1,
+        },
+    };
+    if (i2c_new_master_bus(&cfg, &bus) != ESP_OK) {
+        ESP_LOGE(TAG, "cannot create I2C bus on SDA=%d SCL=%d", CONFIG_ROBOT_I2C_SDA, CONFIG_ROBOT_I2C_SCL);
+        return nullptr;
+    }
+    return bus;
+}
+
+bool RobotBase::Init(i2c_master_bus_handle_t i2c_bus) {
+    if (initialized_) return true;
+    mu_ = xSemaphoreCreateMutex();
+
+    // ---- configuration (menuconfig: Xiaozhi Assistant -> Robot Base) ----------------------
+    robot::ControllerConfig cc;
+#ifdef CONFIG_ROBOT_WANDER_ENABLE
+    cc.wander = true;
+#else
+    cc.wander = false;
+#endif
+#ifdef CONFIG_ROBOT_STOP_WHEN_LISTENING
+    cc.stop_when_listening = true;
+#else
+    cc.stop_when_listening = false;
+#endif
+#ifdef CONFIG_ROBOT_ALLOW_NO_SENSOR
+    cc.allow_no_sensor = true;
+#else
+    cc.allow_no_sensor = false;
+#endif
+#ifdef CONFIG_ROBOT_BLIND_REVERSE
+    cc.blind_reverse = true;
+#else
+    cc.blind_reverse = false;
+#endif
+#ifdef CONFIG_ROBOT_FACE_REACTION
+    cc.face_reaction = true;
+#else
+    cc.face_reaction = false;
+#endif
+    cc.reverse_max_ms = CONFIG_ROBOT_REVERSE_MAX_MS;
+    cc.emotion_max_ms = (uint32_t)CONFIG_ROBOT_EMOTION_MAX_SEC * 1000u;
+    allow_no_sensor_ = cc.allow_no_sensor;
+    ctl_ = std::make_unique<robot::RobotController>(cc, (uint32_t)esp_timer_get_time());
+
+    // ---- head servo ---------------------------------------------------------------------
+    HeadServo::Config hc;
+    hc.pin = (gpio_num_t)CONFIG_ROBOT_PIN_SERVO;
+    hc.center_deg = CONFIG_ROBOT_HEAD_CENTER_DEG;
+    hc.range_deg = CONFIG_ROBOT_HEAD_RANGE_DEG;
+#ifdef CONFIG_ROBOT_HEAD_INVERT
+    hc.invert = true;
+#endif
+    hc.min_us = CONFIG_ROBOT_SERVO_MIN_US;
+    hc.max_us = CONFIG_ROBOT_SERVO_MAX_US;
+    bool head_ok = head_.Init(hc);
+
+    // ---- wheels -------------------------------------------------------------------------
+    MotorDriver::Config mc;
+    mc.left_in1 = (gpio_num_t)CONFIG_ROBOT_PIN_MOTOR_L_IN1;
+    mc.left_in2 = (gpio_num_t)CONFIG_ROBOT_PIN_MOTOR_L_IN2;
+    mc.right_in1 = (gpio_num_t)CONFIG_ROBOT_PIN_MOTOR_R_IN1;
+    mc.right_in2 = (gpio_num_t)CONFIG_ROBOT_PIN_MOTOR_R_IN2;
+#ifdef CONFIG_ROBOT_MOTOR_L_INVERT
+    mc.left_invert = true;
+#endif
+#ifdef CONFIG_ROBOT_MOTOR_R_INVERT
+    mc.right_invert = true;
+#endif
+    mc.min_start_pct = CONFIG_ROBOT_MOTOR_MIN_START_PCT;
+    mc.max_pct = CONFIG_ROBOT_MOTOR_MAX_PCT;
+    bool motors_ok = motors_.Init(mc);
+
+    // ---- laser guard --------------------------------------------------------------------
+    RangeGuard::Config gc;
+    gc.int_pin = (gpio_num_t)CONFIG_ROBOT_PIN_TOF_INT;
+    gc.cliff_mm = CONFIG_ROBOT_CLIFF_MM;
+    gc.obstacle_margin_mm = CONFIG_ROBOT_OBSTACLE_MARGIN_MM;
+    bool guard_ok = guard_.Init(i2c_bus, gc);
+    if (guard_ok) {
+        // Hardware-level interlock: the moment anything but a clear floor is reported,
+        // forward motion is cut right in the sensor task (does not wait for the 20 ms engine tick).
+        guard_.SetHazardCallback([this](robot::Hazard h) { motors_.SetForwardInhibit(h != robot::Hazard::kNone); });
+        motors_.SetForwardInhibit(true);  // until the first clean samples arrive
+    } else {
+        ESP_LOGE(TAG, "laser guard NOT available -> wheels are disabled%s",
+                 allow_no_sensor_ ? " (CONFIG_ROBOT_ALLOW_NO_SENSOR is ON: wheels enabled WITHOUT protection!)" : "");
+    }
+
+    RegisterTools();
+    RobotEmotionHook::Set([this](const char* e) { OnEmotion(e); });
+
+    initialized_ = true;
+    xTaskCreate(TaskEntry, "robot_engine", 4096, this, 5, nullptr);
+    ESP_LOGI(TAG, "robot base up: head=%d motors=%d guard=%d", head_ok, motors_ok, guard_ok);
+    return head_ok && motors_ok && guard_ok;
+}
+
+bool RobotBase::LocomotionAllowed() const {
+    return guard_.healthy() || allow_no_sensor_;
+}
+
+void RobotBase::OnEmotion(const char* emotion) {
+    if (!initialized_ || !emotion) return;
+    xSemaphoreTake(mu_, portMAX_DELAY);
+    perform_end_ms_ = 0;                 // a real emotion from the server replaces a tool-driven one
+    ctl_->SetEmotion(emotion);
+    xSemaphoreGive(mu_);
+}
+
+void RobotBase::SetFace(const char* emotion) {
+    auto* display = Board::GetInstance().GetDisplay();
+    if (!display || !emotion) return;
+    // Display calls belong to the main task, like application.cc does it.
+    Application::GetInstance().Schedule([display, e = std::string(emotion)]() { display->SetEmotion(e.c_str()); });
+}
+
+void RobotBase::TaskEntry(void* arg) {
+    static_cast<RobotBase*>(arg)->Loop();
+    vTaskDelete(nullptr);
+}
+
+void RobotBase::Loop() {
+    const float dt_s = TICK_MS / 1000.0f;
+    const float kAccel = 300.0f, kDecel = 800.0f;   // wheel % per second
+    const float kHeadRate = 450.0f;                 // head pose units per second
+    TickType_t last = xTaskGetTickCount();
+    int last_pose = 9999;
+
+    for (;;) {
+        vTaskDelayUntil(&last, pdMS_TO_TICKS(TICK_MS));
+
+        DeviceState st = Application::GetInstance().GetDeviceState();
+        robot::ControllerInput in;
+        in.dt_ms = TICK_MS;
+        in.hazard = guard_.present() ? guard_.hazard() : robot::Hazard::kSensorFault;
+        in.sensor_ok = guard_.healthy();
+        in.listening = (st == kDeviceStateListening);
+        in.idle = (st == kDeviceStateIdle);
+
+        robot::ControllerOutput out;
+        xSemaphoreTake(mu_, portMAX_DELAY);
+        if (perform_end_ms_ && NowMs() >= perform_end_ms_) {
+            perform_end_ms_ = 0;
+            ctl_->SetEmotion("neutral");
+            SetFace("neutral");
+        }
+        out = ctl_->Tick(in);
+        xSemaphoreGive(mu_);
+
+        if (out.face) SetFace(out.face);
+
+        // wheels: slew-rate limited, the hardware interlock in MotorDriver still has the last word
+        cur_l_ = robot::RampToward(cur_l_, (float)out.left, dt_s, kAccel, kDecel);
+        cur_r_ = robot::RampToward(cur_r_, (float)out.right, dt_s, kAccel, kDecel);
+        motors_.Drive((int)lroundf(cur_l_), (int)lroundf(cur_r_));
+
+        // head
+        cur_head_ = robot::RampToward(cur_head_, out.head, dt_s, kHeadRate, kHeadRate);
+        int pose = (int)lroundf(cur_head_);
+        if (pose != last_pose) {
+            head_.SetPose(pose);
+            last_pose = pose;
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------------------
+// MCP tools (what the LLM can call)
+// ---------------------------------------------------------------------------------------
+void RobotBase::RegisterTools() {
+    auto& mcp = McpServer::GetInstance();
+
+    mcp.AddTool("self.robot.get_status",
+                "Get robot status: current mode/behavior, laser distance to the floor ahead in mm, hazard "
+                "(none/obstacle/cliff/sensor_fault/unknown), calibrated floor distance, head pose, wander on/off.",
+                PropertyList(), [this](const PropertyList&) -> ReturnValue {
+                    xSemaphoreTake(mu_, portMAX_DELAY);
+                    cJSON* j = cJSON_CreateObject();
+                    cJSON_AddStringToObject(j, "mode", ctl_->ModeName());
+                    cJSON_AddStringToObject(j, "behavior", ctl_->BehaviorName());
+                    cJSON_AddStringToObject(j, "emotion", ctl_->last_emotion());
+                    cJSON_AddBoolToObject(j, "wander", ctl_->wander_enabled());
+                    xSemaphoreGive(mu_);
+                    cJSON_AddStringToObject(j, "hazard", robot::HazardName(guard_.hazard()));
+                    cJSON_AddNumberToObject(j, "distance_mm", guard_.distance_mm());
+                    cJSON_AddNumberToObject(j, "floor_mm", guard_.floor_mm());
+                    cJSON_AddBoolToObject(j, "sensor_ok", guard_.healthy());
+                    cJSON_AddNumberToObject(j, "head_pose", head_.pose());
+                    char* s = cJSON_PrintUnformatted(j);
+                    std::string r(s);
+                    cJSON_free(s);
+                    cJSON_Delete(j);
+                    return r;
+                });
+
+    mcp.AddTool("self.robot.move",
+                "Drive the robot wheels for a short time. direction: forward, backward, left (curve left), "
+                "right (curve right), spin_left, spin_right. speed 10-100 percent, duration_ms 100-5000. "
+                "The laser guard stops forward motion automatically at obstacles and table edges.",
+                PropertyList({Property("direction", kPropertyTypeString, "forward"),
+                              Property("speed", kPropertyTypeInteger, 40, 10, 100),
+                              Property("duration_ms", kPropertyTypeInteger, 1000, 100, 5000)}),
+                [this](const PropertyList& p) -> ReturnValue {
+                    if (!LocomotionAllowed()) {
+                        throw std::runtime_error("Laser guard not working: wheels disabled for safety");
+                    }
+                    std::string d = p["direction"].value<std::string>();
+                    int s = p["speed"].value<int>();
+                    uint32_t ms = (uint32_t)p["duration_ms"].value<int>();
+                    int l, r;
+                    if (d == "forward") { l = s; r = s; }
+                    else if (d == "backward") { l = -s; r = -s; }
+                    else if (d == "left") { l = s * 3 / 10; r = s; }
+                    else if (d == "right") { l = s; r = s * 3 / 10; }
+                    else if (d == "spin_left") { l = -s; r = s; }
+                    else if (d == "spin_right") { l = s; r = -s; }
+                    else throw std::runtime_error("Unknown direction: " + d);
+                    xSemaphoreTake(mu_, portMAX_DELAY);
+                    ctl_->ManualMove(l, r, ms);
+                    xSemaphoreGive(mu_);
+                    return true;
+                });
+
+    mcp.AddTool("self.robot.stop", "Stop the wheels and cancel the current emotion/behavior.", PropertyList(),
+                [this](const PropertyList&) -> ReturnValue {
+                    xSemaphoreTake(mu_, portMAX_DELAY);
+                    perform_end_ms_ = 0;
+                    ctl_->Stop();
+                    xSemaphoreGive(mu_);
+                    return true;
+                });
+
+    mcp.AddTool("self.robot.head",
+                "Move the head (screen). pose -100 (head down) .. 0 (centre) .. +100 (head up). "
+                "It holds for hold_ms then returns to normal behaviour.",
+                PropertyList({Property("pose", kPropertyTypeInteger, 0, -100, 100),
+                              Property("hold_ms", kPropertyTypeInteger, 3000, 300, 10000)}),
+                [this](const PropertyList& p) -> ReturnValue {
+                    xSemaphoreTake(mu_, portMAX_DELAY);
+                    ctl_->ManualHead(p["pose"].value<int>(), (uint32_t)p["hold_ms"].value<int>());
+                    xSemaphoreGive(mu_);
+                    return true;
+                });
+
+    mcp.AddTool("self.robot.perform",
+                "Act out an emotion with wheels, head and face. emotion: happy, laughing, silly, sad, crying, "
+                "angry, sleepy, surprised, confused, embarrassed, loving, thinking, cool, relaxed, winking, "
+                "delicious, neutral. duration_s 1-60, then it returns to neutral.",
+                PropertyList({Property("emotion", kPropertyTypeString, "happy"),
+                              Property("duration_s", kPropertyTypeInteger, 8, 1, 60)}),
+                [this](const PropertyList& p) -> ReturnValue {
+                    std::string e = p["emotion"].value<std::string>();
+                    bool known = false;
+                    robot::FindEmotionBehavior(e.c_str(), &known);
+                    if (!known) throw std::runtime_error("Unknown emotion: " + e);
+                    xSemaphoreTake(mu_, portMAX_DELAY);
+                    ctl_->SetEmotion(e.c_str());
+                    perform_end_ms_ = (e == "neutral") ? 0 : NowMs() + (int64_t)p["duration_s"].value<int>() * 1000;
+                    xSemaphoreGive(mu_);
+                    SetFace(e.c_str());
+                    return true;
+                });
+
+    mcp.AddTool("self.robot.set_wander",
+                "Turn idle wandering (random driving and spinning while the robot is idle) on or off.",
+                PropertyList({Property("enabled", kPropertyTypeBoolean)}),
+                [this](const PropertyList& p) -> ReturnValue {
+                    xSemaphoreTake(mu_, portMAX_DELAY);
+                    ctl_->SetWander(p["enabled"].value<bool>());
+                    xSemaphoreGive(mu_);
+                    return true;
+                });
+
+    mcp.AddTool("self.robot.calibrate_floor",
+                "Re-measure the laser distance to the floor. Only call it when the robot stands on a flat floor "
+                "with nothing in front. Takes about one second.",
+                PropertyList(), [this](const PropertyList&) -> ReturnValue {
+                    bool ok = guard_.Calibrate();
+                    cJSON* j = cJSON_CreateObject();
+                    cJSON_AddBoolToObject(j, "ok", ok);
+                    cJSON_AddNumberToObject(j, "floor_mm", guard_.floor_mm());
+                    char* s = cJSON_PrintUnformatted(j);
+                    std::string r(s);
+                    cJSON_free(s);
+                    cJSON_Delete(j);
+                    return r;
+                });
+}
