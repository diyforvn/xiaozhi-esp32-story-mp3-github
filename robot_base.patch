@@ -0,0 +1,225 @@
+#include "robot_controller.h"
+
+#include <string.h>
+
+namespace robot {
+
+RobotController::RobotController(const ControllerConfig& cfg, uint32_t seed)
+    : cfg_(cfg), emo_(seed * 2654435761u + 1), wan_(seed * 40503u + 7), ref_(seed * 69069u + 3) {}
+
+void RobotController::SetEmotion(const char* name) {
+    bool known = false;
+    const Behavior* b = FindEmotionBehavior(name, &known);
+    if (!known) return;                                  // unknown label: keep what we are doing
+    strncpy(last_emotion_, (name && *name) ? name : "neutral", sizeof(last_emotion_) - 1);
+    last_emotion_[sizeof(last_emotion_) - 1] = '\0';
+    if (!b) {                                            // neutral
+        emo_.Stop();
+        emo_active_ = false;
+        return;
+    }
+    if (emo_active_ && emo_.behavior() == b) {           // same emotion repeated: just refresh the timer
+        emo_age_ = 0;
+        return;
+    }
+    emo_.Start(b);
+    emo_active_ = true;
+    emo_age_ = 0;
+    wan_.Stop();
+    wander_pause_ms_ = 3000;
+}
+
+void RobotController::EndEmotion() {
+    emo_.Stop();
+    emo_active_ = false;
+    strcpy(last_emotion_, "neutral");
+    if (cfg_.face_reaction) pending_face_ = "neutral";
+}
+
+void RobotController::ManualMove(int l, int r, uint32_t dur_ms) {
+    if (l > 100) l = 100;
+    if (l < -100) l = -100;
+    if (r > 100) r = 100;
+    if (r < -100) r = -100;
+    man_l_ = l;
+    man_r_ = r;
+    man_ms_ = dur_ms;
+}
+
+void RobotController::ManualHead(int pose, uint32_t hold_ms) {
+    if (pose > 100) pose = 100;
+    if (pose < -100) pose = -100;
+    head_pose_ = pose;
+    head_hold_ms_ = hold_ms;
+}
+
+void RobotController::Stop() {
+    man_ms_ = 0;
+    head_hold_ms_ = 0;
+    emo_.Stop();
+    emo_active_ = false;
+    ref_.Stop();
+    reflex_active_ = false;
+    wan_.Stop();
+    wander_pause_ms_ = 3000;
+}
+
+const Behavior* RobotController::PickWander() {
+    uint32_t total = 0;
+    for (size_t i = 0; i < kWanderCount; i++) total += kWanderWeights[i];
+    uint32_t pick = wan_.Rand() % total;
+    for (size_t i = 0; i < kWanderCount; i++) {
+        if (pick < kWanderWeights[i]) return kWanderBehaviors[i];
+        pick -= kWanderWeights[i];
+    }
+    return kWanderBehaviors[0];
+}
+
+void RobotController::StartReflex(Hazard h) {
+    ref_.Start(h == Hazard::kCliff ? &kReflexCliff : &kReflexObstacle);
+    reflex_active_ = true;
+    man_ms_ = 0;                 // a reflex cancels manual driving
+    wan_.Stop();
+    wander_pause_ms_ = 800;
+    if (cfg_.face_reaction) pending_face_ = (h == Hazard::kCliff) ? "shocked" : "surprised";
+
+    // stuck detection: 6 reflexes within 20 s => stop moving for a while
+    for (int i = 0; i < 5; i++) reflex_hist_[i] = reflex_hist_[i + 1];
+    reflex_hist_[5] = now_ms_;
+    if (reflex_hist_n_ < 6) reflex_hist_n_++;
+    if (reflex_hist_n_ == 6 && now_ms_ - reflex_hist_[0] <= 20000) {
+        stuck_ms_ = 15000;
+        reflex_hist_n_ = 0;
+        if (cfg_.face_reaction) pending_face_ = "confused";
+    }
+}
+
+ControllerOutput RobotController::Tick(const ControllerInput& in) {
+    ControllerOutput out;
+    const uint32_t dt = in.dt_ms;
+    now_ms_ += dt;
+    pending_face_ = nullptr;
+
+    const bool loco_ok = in.sensor_ok || cfg_.allow_no_sensor;
+    const bool quiet = cfg_.stop_when_listening && in.listening;
+    if (stuck_ms_ > 0) stuck_ms_ = stuck_ms_ > dt ? stuck_ms_ - dt : 0;
+
+    auto gate = [&](int& a, int& b) {
+        if (!loco_ok || quiet || stuck_ms_ > 0) { a = 0; b = 0; }
+        if (!cfg_.blind_reverse && a + b < 0) { a = 0; b = 0; }
+    };
+
+    int l = 0, r = 0;
+    float head = in.listening ? (float)cfg_.listening_head : 0.f;
+    Mode mode = Mode::kRest;
+
+    if (!reflex_active_) {
+        // ---- intent from the normal sources: manual > emotion > wander > rest
+        if (man_ms_ > 0) {
+            l = man_l_;
+            r = man_r_;
+            man_ms_ = man_ms_ > dt ? man_ms_ - dt : 0;
+            mode = Mode::kManual;
+        } else if (emo_active_) {
+            PlayerOut po = emo_.Tick(dt);
+            l = po.left;
+            r = po.right;
+            head = po.head;
+            emo_age_ += dt;
+            mode = Mode::kEmotion;
+            if (emo_age_ >= cfg_.emotion_max_ms) EndEmotion();
+        } else if (cfg_.wander && in.idle) {
+            if (wan_.active()) {
+                PlayerOut po = wan_.Tick(dt);
+                l = po.left;
+                r = po.right;
+                head = po.head;
+                mode = Mode::kWander;
+                if (po.finished) {
+                    wan_.Stop();
+                    wander_pause_ms_ = 1500 + (int32_t)(wan_.Rand() % 3000u);
+                }
+            } else {
+                wander_pause_ms_ -= (int32_t)dt;
+                if (wander_pause_ms_ <= 0) wan_.Start(PickWander());
+            }
+        }
+        gate(l, r);
+
+        // ---- laser reflex: only when we are really about to drive forward into a hazard
+        if ((in.hazard == Hazard::kCliff || in.hazard == Hazard::kObstacle) && in.sensor_ok &&
+            (l + r) > 10) {
+            StartReflex(in.hazard);
+        }
+    }
+
+    if (reflex_active_) {
+        PlayerOut po = ref_.Tick(dt);
+        l = po.left;
+        r = po.right;
+        head = po.head;
+        mode = Mode::kReflex;
+        gate(l, r);
+        if (po.finished) {
+            reflex_active_ = false;
+            ref_.Stop();
+            if (cfg_.face_reaction && !pending_face_) pending_face_ = last_emotion_;
+        }
+    }
+    if (stuck_ms_ > 0) mode = Mode::kStuck;
+
+    // ---- final safety stage -------------------------------------------------
+    // 1) contiguous reverse cap (nothing looks behind the robot)
+    bool want_rev = (l + r) < 0;
+    if (rev_block_ms_ > 0) {
+        rev_block_ms_ -= (int32_t)dt;
+        if (want_rev) { l = 0; r = 0; want_rev = false; }
+    }
+    if (want_rev) {
+        rev_run_ms_ += dt;
+        if (rev_run_ms_ > cfg_.reverse_max_ms) {
+            l = 0; r = 0;
+            rev_block_ms_ = 600;
+            rev_run_ms_ = 0;
+        }
+    } else {
+        rev_run_ms_ = 0;
+    }
+    // 2) never drive net-forward while the guard reports anything but a clear floor
+    if (in.sensor_ok && in.hazard != Hazard::kNone) RemoveNetForward(l, r);
+
+    // head override from the MCP tool
+    if (head_hold_ms_ > 0) {
+        head = (float)head_pose_;
+        head_hold_ms_ = head_hold_ms_ > dt ? head_hold_ms_ - dt : 0;
+    }
+
+    mode_ = mode;
+    out.left = l;
+    out.right = r;
+    out.head = head;
+    out.face = pending_face_;
+    return out;
+}
+
+const char* RobotController::ModeName() const {
+    switch (mode_) {
+        case Mode::kRest: return "rest";
+        case Mode::kWander: return "wander";
+        case Mode::kEmotion: return "emotion";
+        case Mode::kManual: return "manual";
+        case Mode::kReflex: return "reflex";
+        case Mode::kStuck: return "stuck";
+    }
+    return "?";
+}
+
+const char* RobotController::BehaviorName() const {
+    if (reflex_active_ && ref_.behavior()) return ref_.behavior()->name;
+    if (man_ms_ > 0) return "manual";
+    if (emo_active_ && emo_.behavior()) return emo_.behavior()->name;
+    if (wan_.active() && wan_.behavior()) return wan_.behavior()->name;
+    return "";
+}
+
+}  // namespace robot
diff --git a/main/robot_base/robot_controller.h b/main/robot_base/robot_controller.h
new file mode 100644
index 0000000..d76da5a
--- /dev/null
+++ b/main/robot_base/robot_controller.h
@@ -0,0 +1,79 @@
+// Decision layer: turns emotions / commands / idle wandering into wheel + head targets,
+// and enforces every safety rule. Pure C++ (no ESP-IDF) so it can be tested on a PC.
+#pragma once
+#include "robot_logic.h"
+
+namespace robot {
+
+struct ControllerConfig {
+    bool wander = true;               // idle wandering when device is idle
+    bool stop_when_listening = true;  // wheels silent while the device is listening to the user
+    bool allow_no_sensor = false;     // DANGEROUS: allow driving when the laser guard is not working
+    bool blind_reverse = true;        // allow reversing (there is no rear sensor)
+    uint16_t reverse_max_ms = 700;    // max contiguous reverse time
+    uint32_t emotion_max_ms = 90000;  // an emotion behavior falls back to neutral after this
+    bool face_reaction = true;        // ask the display for surprised/shocked on reflex
+    int listening_head = 15;          // head pose while listening
+};
+
+struct ControllerInput {
+    uint32_t dt_ms = 20;
+    Hazard hazard = Hazard::kUnknown;
+    bool sensor_ok = false;  // laser guard alive: fresh samples and no I2C fault
+    bool listening = false;  // DeviceState == listening
+    bool idle = false;       // DeviceState == idle
+};
+
+struct ControllerOutput {
+    int left = 0;                 // percent -100..100, already safety-filtered
+    int right = 0;
+    float head = 0;               // pose -100..100
+    const char* face = nullptr;   // non-null: ask the display to show this emotion now
+};
+
+enum class Mode : uint8_t { kRest, kWander, kEmotion, kManual, kReflex, kStuck };
+
+class RobotController {
+public:
+    explicit RobotController(const ControllerConfig& cfg, uint32_t seed = 7);
+
+    void SetEmotion(const char* name);                 // "neutral" ends the current emotion
+    void ManualMove(int left, int right, uint32_t duration_ms);
+    void ManualHead(int pose, uint32_t hold_ms);
+    void Stop();                                       // cancel manual / emotion / reflex
+    void SetWander(bool on) { cfg_.wander = on; if (!on) wan_.Stop(); }
+    bool wander_enabled() const { return cfg_.wander; }
+
+    ControllerOutput Tick(const ControllerInput& in);
+
+    Mode mode() const { return mode_; }
+    const char* ModeName() const;
+    const char* BehaviorName() const;
+    const char* last_emotion() const { return last_emotion_; }
+
+private:
+    void StartReflex(Hazard h);
+    void EndEmotion();
+    const Behavior* PickWander();
+
+    ControllerConfig cfg_;
+    BehaviorPlayer emo_, wan_, ref_;
+    bool emo_active_ = false, reflex_active_ = false;
+    uint32_t emo_age_ = 0;
+    int man_l_ = 0, man_r_ = 0;
+    uint32_t man_ms_ = 0;
+    int head_pose_ = 0;
+    uint32_t head_hold_ms_ = 0;
+    int32_t wander_pause_ms_ = 1500;
+    uint32_t stuck_ms_ = 0;
+    uint32_t now_ms_ = 0;
+    uint32_t reflex_hist_[6] = {0};
+    uint8_t reflex_hist_n_ = 0;
+    uint32_t rev_run_ms_ = 0;
+    int32_t rev_block_ms_ = 0;
+    const char* pending_face_ = nullptr;
+    char last_emotion_[24] = "neutral";
+    Mode mode_ = Mode::kRest;
+};
+
+}  // namespace robot
diff --git a/main/robot_base/robot_emotion_hook.h b/main/robot_base/robot_emotion_hook.h
new file mode 100644
index 0000000..3dcbe9a
--- /dev/null
+++ b/main/robot_base/robot_emotion_hook.h
@@ -0,0 +1,18 @@
+// Tiny hook so the robot base can follow the emotion that xiaozhi sends to the display,
+// regardless of the display type (OLED Mochi face or TFT robot eyes).
+// application.cc calls RobotEmotionHook::Notify(...) right after display->SetEmotion(...).
+#pragma once
+#include <functional>
+#include <utility>
+
+namespace RobotEmotionHook {
+using Handler = std::function<void(const char*)>;
+inline Handler& handler() {
+    static Handler h;
+    return h;
+}
+inline void Set(Handler h) { handler() = std::move(h); }
+inline void Notify(const char* emotion) {
+    if (handler()) handler()(emotion);
+}
+}  // namespace RobotEmotionHook
diff --git a/main/robot_base/robot_logic.cc b/main/robot_base/robot_logic.cc
new file mode 100644
index 0000000..c9f0f40
--- /dev/null
+++ b/main/robot_base/robot_logic.cc
@@ -0,0 +1,169 @@
+#include "robot_logic.h"
+
+#include <math.h>
+#include <string.h>
+
+namespace robot {
+
+const char* HazardName(Hazard h) {
+    switch (h) {
+        case Hazard::kUnknown: return "unknown";
+        case Hazard::kNone: return "none";
+        case Hazard::kObstacle: return "obstacle";
+        case Hazard::kCliff: return "cliff";
+        case Hazard::kSensorFault: return "sensor_fault";
+    }
+    return "?";
+}
+
+// ---------------------------------------------------------------------------
+void HazardClassifier::Reset() {
+    cur_ = Hazard::kUnknown;
+    pending_ = Hazard::kUnknown;
+    pend_n_ = 0;
+}
+
+Hazard HazardClassifier::Feed(uint16_t raw_mm, bool io_ok) {
+    Hazard cand;
+    if (!io_ok) {
+        cand = Hazard::kSensorFault;
+    } else if (raw_mm >= cfg_.no_echo_mm) {
+        cand = Hazard::kCliff;                       // no echo: fail safe, treat as a drop
+    } else if (raw_mm > cfg_.cliff_mm) {
+        cand = Hazard::kCliff;
+    } else if (raw_mm < cfg_.min_valid_mm) {
+        cand = Hazard::kObstacle;                    // touching / too close
+    } else if (floor_mm_ > 0 && (uint32_t)raw_mm + cfg_.obstacle_margin_mm < floor_mm_) {
+        cand = Hazard::kObstacle;
+    } else {
+        cand = Hazard::kNone;
+    }
+
+    if (cand == pending_) {
+        if (pend_n_ < 255) pend_n_++;
+    } else {
+        pending_ = cand;
+        pend_n_ = 1;
+    }
+    uint8_t need = cfg_.enter_count;
+    if (cand == Hazard::kNone) need = cfg_.clear_count;
+    else if (cand == Hazard::kSensorFault) need = cfg_.fault_count;
+    if (pend_n_ >= need) cur_ = cand;
+    return cur_;
+}
+
+bool ComputeFloor(uint16_t* s, size_t n, uint16_t cliff_mm, uint16_t* floor_out) {
+    if (n < 10) return false;
+    for (size_t i = 1; i < n; i++) {           // insertion sort
+        uint16_t v = s[i];
+        size_t j = i;
+        while (j > 0 && s[j - 1] > v) { s[j] = s[j - 1]; j--; }
+        s[j] = v;
+    }
+    uint16_t med = s[n / 2];
+    uint16_t p10 = s[n / 10];
+    uint16_t p90 = s[n - 1 - n / 10];
+    if (p90 - p10 > 15) return false;                    // too noisy
+    if (med + 15 > cliff_mm) return false;               // floor must be clearly below the cliff threshold
+    if (med < 30) return false;                          // too close to be a floor
+    *floor_out = med;
+    return true;
+}
+
+// ---------------------------------------------------------------------------
+uint32_t BehaviorPlayer::Rand() {
+    uint32_t x = rng_;
+    x ^= x << 13;
+    x ^= x >> 17;
+    x ^= x << 5;
+    rng_ = x ? x : 1;
+    return rng_;
+}
+
+void BehaviorPlayer::BeginStep(uint8_t idx) {
+    idx_ = idx;
+    const Step& s = b_->steps[idx];
+    step_elapsed_ = 0;
+    step_dur_ = s.dur_ms + (s.jitter_ms ? (Rand() % (s.jitter_ms + 1u)) : 0u);
+    mirror_ = (s.flags & kFlagMirror) && (Rand() & 1);
+}
+
+void BehaviorPlayer::Start(const Behavior* b) {
+    b_ = b;
+    total_ = 0;
+    rev_used_ = 0;
+    done_ = false;
+    if (b_ && b_->count > 0) BeginStep(0);
+    else b_ = nullptr;
+}
+
+PlayerOut BehaviorPlayer::Tick(uint32_t dt_ms) {
+    PlayerOut out;
+    if (!b_) { out.finished = true; return out; }
+
+    total_ += dt_ms;
+    if (b_->max_total_ms && total_ >= b_->max_total_ms) done_ = true;
+
+    const Step& s = b_->steps[idx_];
+    float head = (float)s.head;
+    if (!done_ && s.osc_ms > 0 && s.osc_amp > 0) {
+        head += (float)s.osc_amp * sinf(6.2831853f * (float)(total_ % 600000u) / (float)s.osc_ms);
+    }
+    if (head > 100) head = 100;
+    if (head < -100) head = -100;
+    out.head = head;
+
+    if (done_) {                       // hold the last pose, wheels stopped
+        out.finished = true;
+        return out;
+    }
+
+    int l = s.left, r = s.right;
+    if (mirror_) { int t = l; l = r; r = t; }
+    if (l + r < 0) {                   // net reverse: spend the reverse budget
+        rev_used_ += dt_ms;
+        if (b_->max_reverse_ms && rev_used_ > b_->max_reverse_ms) { l = 0; r = 0; }
+    }
+    out.left = l;
+    out.right = r;
+
+    step_elapsed_ += dt_ms;
+    if (step_elapsed_ >= step_dur_) {
+        uint8_t next = idx_ + 1;
+        if (next >= b_->count) {
+            if (b_->loop) next = 0;
+            else { done_ = true; return out; }
+        }
+        BeginStep(next);
+    }
+    return out;
+}
+
+// ---------------------------------------------------------------------------
+void RemoveNetForward(int& l, int& r) {
+    int s = l + r;
+    if (s > 0) {
+        l -= s / 2;
+        r -= s - s / 2;
+    }
+}
+
+int ToDutyPercent(int s, int min_start_pct, int max_pct) {
+    if (s == 0) return 0;
+    int a = s < 0 ? -s : s;
+    if (a > 100) a = 100;
+    if (max_pct < min_start_pct) max_pct = min_start_pct;
+    int duty = min_start_pct + (max_pct - min_start_pct) * a / 100;
+    return s < 0 ? -duty : duty;
+}
+
+float RampToward(float cur, float target, float dt_s, float accel, float decel) {
+    bool speeding_up = fabsf(target) > fabsf(cur) && (target * cur >= 0);
+    float step = (speeding_up ? accel : decel) * dt_s;
+    float diff = target - cur;
+    if (diff > step) return cur + step;
+    if (diff < -step) return cur - step;
+    return target;
+}
+
+}  // namespace robot
diff --git a/main/robot_base/robot_logic.h b/main/robot_base/robot_logic.h
new file mode 100644
index 0000000..c08820c
--- /dev/null
+++ b/main/robot_base/robot_logic.h
@@ -0,0 +1,128 @@
+// Pure C++ logic for the xiaozhi robot base (no ESP-IDF dependency, unit-testable on a PC).
+//  - HazardClassifier : VL53L0X distance -> {none, obstacle, cliff, fault}
+//  - BehaviorPlayer   : plays a table of timed steps (wheels + head pose)
+//  - helpers          : forward-inhibit filter, duty mapping, ramps
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+
+namespace robot {
+
+// ---------------------------------------------------------------------------
+// Hazard classification
+// ---------------------------------------------------------------------------
+enum class Hazard : uint8_t {
+    kUnknown = 0,   // not calibrated / no valid sample yet  -> forward is inhibited
+    kNone,          // floor ahead looks normal
+    kObstacle,      // something closer than the calibrated floor distance
+    kCliff,         // floor farther than the cliff threshold, or no echo at all
+    kSensorFault,   // I2C / sensor failure
+};
+const char* HazardName(Hazard h);
+
+struct HazardConfig {
+    uint16_t cliff_mm = 150;           // reading above this => drop / table edge
+    uint16_t obstacle_margin_mm = 30;  // reading below (floor - margin) => obstacle
+    uint16_t min_valid_mm = 30;        // below this the sensor is too close => obstacle
+    uint16_t no_echo_mm = 8000;        // VL53L0X reports ~8190 / 65535 when nothing is seen
+    uint8_t enter_count = 2;           // consecutive samples to enter a hazard
+    uint8_t clear_count = 3;           // consecutive clean samples to clear it
+    uint8_t fault_count = 3;           // consecutive I2C failures => kSensorFault
+};
+
+class HazardClassifier {
+public:
+    void Configure(const HazardConfig& c) { cfg_ = c; }
+    const HazardConfig& config() const { return cfg_; }
+    void SetFloor(uint16_t floor_mm) { floor_mm_ = floor_mm; }   // 0 = obstacle detection off
+    uint16_t floor_mm() const { return floor_mm_; }
+    void Reset();
+    // raw_mm: sensor reading; io_ok=false when the I2C read failed / timed out
+    Hazard Feed(uint16_t raw_mm, bool io_ok);
+    Hazard current() const { return cur_; }
+
+private:
+    HazardConfig cfg_;
+    uint16_t floor_mm_ = 0;
+    Hazard cur_ = Hazard::kUnknown;
+    Hazard pending_ = Hazard::kUnknown;
+    uint8_t pend_n_ = 0;
+};
+
+// Median-based floor calibration. Returns false when the samples are too few,
+// too noisy, or the floor is not clearly below the cliff threshold.
+bool ComputeFloor(uint16_t* samples, size_t n, uint16_t cliff_mm, uint16_t* floor_out);
+
+// ---------------------------------------------------------------------------
+// Behaviors (timed step tables)
+// ---------------------------------------------------------------------------
+enum : uint8_t { kFlagMirror = 1 };  // randomly swap left/right at step start (random turn direction)
+
+struct Step {
+    int8_t left;        // wheel command, percent -100..100
+    int8_t right;
+    int8_t head;        // head pose -100 (down) .. +100 (up)
+    uint8_t osc_amp;    // head oscillation amplitude (pose units)
+    uint16_t osc_ms;    // oscillation period, 0 = none
+    uint16_t dur_ms;
+    uint16_t jitter_ms; // + random 0..jitter_ms
+    uint8_t flags;
+};
+
+struct Behavior {
+    const char* name;
+    const Step* steps;
+    uint8_t count;
+    bool loop;
+    uint16_t max_reverse_ms;  // total time allowed with net-reverse wheels per run (0 = unlimited)
+    uint32_t max_total_ms;    // 0 = until stopped
+};
+
+struct PlayerOut {
+    int left = 0;
+    int right = 0;
+    float head = 0;
+    bool finished = false;
+};
+
+class BehaviorPlayer {
+public:
+    explicit BehaviorPlayer(uint32_t seed = 12345) : rng_(seed ? seed : 1) {}
+    void Start(const Behavior* b);
+    void Stop() { b_ = nullptr; }
+    bool active() const { return b_ != nullptr; }
+    const Behavior* behavior() const { return b_; }
+    PlayerOut Tick(uint32_t dt_ms);
+    uint32_t Rand();  // shared RNG (xorshift32)
+
+private:
+    void BeginStep(uint8_t idx);
+    const Behavior* b_ = nullptr;
+    uint8_t idx_ = 0;
+    uint32_t step_elapsed_ = 0, step_dur_ = 0, total_ = 0, rev_used_ = 0;
+    bool mirror_ = false, done_ = false;
+    uint32_t rng_;
+};
+
+// ---------------------------------------------------------------------------
+// Motor helpers
+// ---------------------------------------------------------------------------
+// Remove the net-forward component (keeps rotation). (l+r) > 0  =>  (l+r) == 0
+void RemoveNetForward(int& l, int& r);
+// Map -100..100 to signed duty percent with start-up deadzone compensation.
+int ToDutyPercent(int s, int min_start_pct, int max_pct);
+// Slew-rate limiter (units/s). Uses accel when speeding up, decel otherwise.
+float RampToward(float cur, float target, float dt_s, float accel, float decel);
