+    VL53L0X();
+    ~VL53L0X();
+
+    // Attach to an existing i2c_master bus (shared with the OLED). addr7 = 0x29 by default.
+    bool attach(i2c_master_bus_handle_t bus, uint8_t addr7 = 0x29, uint32_t scl_hz = 400000);
+
